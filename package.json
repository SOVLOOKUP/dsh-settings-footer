{
  "name": "dsh-settings-footer",
  "version": "2.0.2",
  "description": "Move the sidebar Settings entry to a row at the top of the sidebar, hide the 新会话 button, and empty the sidebar footer.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SOVLOOKUP/dsh-settings-footer.git"
  },
  "homepage": "https://github.com/SOVLOOKUP/dsh-settings-footer#readme",
  "bugs": {
    "url": "https://github.com/SOVLOOKUP/dsh-settings-footer/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "web",
    "ui",
    "sidebar",
    "settings"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.client.json && tsc -p tsconfig.host.json",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
